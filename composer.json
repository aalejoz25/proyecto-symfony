{
    "name": "aalejoz25/proyecto-symfony",
    "description": "Aplicación de gestión de tareas desarrollada con Symfony.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "aalejoz25"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^2.20",
        "symfony/asset": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/monolog-bundle": "^3.10",
        "symfony/process": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/web-link": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/maker-bundle": "^1.60",
        "symfony/web-profiler-bundle": "^7.4"
    },
    "config": {
        "allow-plugins": {
            "ocramius/package-versions": false,
            "symfony/flex": false
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {}
}
