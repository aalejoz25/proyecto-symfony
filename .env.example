APP_ENV=dev
APP_SECRET=change-this-development-secret
MYSQL_DATABASE=symfony_master
MYSQL_USER=symfony
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@127.0.0.1:3306/${MYSQL_DATABASE}?serverVersion=8.4.0&charset=utf8mb4"
